{
  "$defs": {
    "CompatibleConnections": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "compatible",
          "title": "Kind",
          "type": "string"
        },
        "allowed": {
          "items": {
            "$ref": "#/$defs/KindPair"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowed",
          "type": "array"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "allowed",
        "ruleId"
      ],
      "title": "CompatibleConnections",
      "type": "object"
    },
    "ConnectionNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "ConnectionNode",
      "type": "object"
    },
    "KindPair": {
      "additionalProperties": false,
      "properties": {
        "sourceKind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Sourcekind",
          "type": "string"
        },
        "targetKind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Targetkind",
          "type": "string"
        }
      },
      "required": [
        "sourceKind",
        "targetKind"
      ],
      "title": "KindPair",
      "type": "object"
    },
    "ResourceCapacity": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "min": {
          "maximum": 600,
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "maximum": 600,
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "target",
        "min",
        "max"
      ],
      "title": "ResourceCapacity",
      "type": "object"
    },
    "ResourceComplete": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all_assigned",
          "title": "Kind",
          "type": "string"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ruleId"
      ],
      "title": "ResourceComplete",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "capacity",
          "title": "Kind",
          "type": "string"
        },
        "limits": {
          "items": {
            "$ref": "#/$defs/ResourceCapacity"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Limits",
          "type": "array"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "limits",
        "ruleId"
      ],
      "title": "ResourceLimits",
      "type": "object"
    },
    "ResourceLoad": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Kind",
          "type": "string"
        },
        "amount": {
          "maximum": 100,
          "minimum": 1,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "amount"
      ],
      "title": "ResourceLoad",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archetype": {
      "const": "resource_balance",
      "title": "Archetype",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "loads": {
      "items": {
        "$ref": "#/$defs/ResourceLoad"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Loads",
      "type": "array"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/ConnectionNode"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Targets",
      "type": "array"
    },
    "allocationRules": {
      "items": {
        "discriminator": {
          "mapping": {
            "capacity": "#/$defs/ResourceLimits",
            "compatible": "#/$defs/CompatibleConnections"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CompatibleConnections"
          },
          {
            "$ref": "#/$defs/ResourceLimits"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Allocationrules",
      "type": "array"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/ResourceComplete"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Goals",
      "type": "array"
    }
  },
  "required": [
    "archetype",
    "schemaVersion",
    "loads",
    "targets",
    "allocationRules",
    "goals"
  ],
  "title": "ResourceBalance",
  "type": "object"
}
