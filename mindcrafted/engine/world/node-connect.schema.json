{
  "$defs": {
    "AcyclicConnections": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "acyclic",
          "title": "Kind",
          "type": "string"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ruleId"
      ],
      "title": "AcyclicConnections",
      "type": "object"
    },
    "CompatibleConnections": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "compatible",
          "title": "Kind",
          "type": "string"
        },
        "allowed": {
          "items": {
            "$ref": "#/$defs/KindPair"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Allowed",
          "type": "array"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "allowed",
        "ruleId"
      ],
      "title": "CompatibleConnections",
      "type": "object"
    },
    "ConnectionDegree": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "degree",
          "title": "Kind",
          "type": "string"
        },
        "node": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Node",
          "type": "string"
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ],
          "title": "Direction",
          "type": "string"
        },
        "min": {
          "maximum": 7,
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "maximum": 7,
          "minimum": 0,
          "title": "Max",
          "type": "integer"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node",
        "direction",
        "min",
        "max",
        "ruleId"
      ],
      "title": "ConnectionDegree",
      "type": "object"
    },
    "ConnectionEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "id"
      ],
      "title": "ConnectionEdge",
      "type": "object"
    },
    "ConnectionGoal": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "ruleId": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "ruleId"
      ],
      "title": "ConnectionGoal",
      "type": "object"
    },
    "ConnectionNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "ConnectionNode",
      "type": "object"
    },
    "KindPair": {
      "additionalProperties": false,
      "properties": {
        "sourceKind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Sourcekind",
          "type": "string"
        },
        "targetKind": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Targetkind",
          "type": "string"
        }
      },
      "required": [
        "sourceKind",
        "targetKind"
      ],
      "title": "KindPair",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archetype": {
      "const": "node_connect",
      "title": "Archetype",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ConnectionNode"
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/ConnectionEdge"
      },
      "maxItems": 12,
      "minItems": 2,
      "title": "Edges",
      "type": "array"
    },
    "connectionRules": {
      "items": {
        "discriminator": {
          "mapping": {
            "acyclic": "#/$defs/AcyclicConnections",
            "compatible": "#/$defs/CompatibleConnections",
            "degree": "#/$defs/ConnectionDegree"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CompatibleConnections"
          },
          {
            "$ref": "#/$defs/ConnectionDegree"
          },
          {
            "$ref": "#/$defs/AcyclicConnections"
          }
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Connectionrules",
      "type": "array"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/ConnectionGoal"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Goals",
      "type": "array"
    }
  },
  "required": [
    "archetype",
    "schemaVersion",
    "nodes",
    "edges",
    "connectionRules",
    "goals"
  ],
  "title": "NodeConnect",
  "type": "object"
}
